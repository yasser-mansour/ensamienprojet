# Copy to .env for local development. Never commit real values.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=ensamien.yassermansour.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ensamien.yassermansour.com
# Shown on the projector and encoded in the QR code
PUBLIC_BASE_URL=https://ensamien.yassermansour.com

# --- Database (PostgreSQL in production; Heroku sets DATABASE_URL automatically) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=60

# --- HTTPS ------------------------------------------------------------------
# 1 in production (secure cookies, HTTPS redirect, HSTS). Set 0 only for local http testing.
DJANGO_SECURE_SSL=1
DJANGO_HSTS_SECONDS=3600

# --- Optional tuning ----------------------------------------------------------
# CACHE_BACKEND=db            # db (default in production, shared by workers) or locmem
# SESSION_LIFETIME_HOURS=12   # join codes stop working after this many hours
# PRESENCE_TIMEOUT_SECONDS=10 # a team is shown offline after this long without polling
# DISPLAY_TOKEN_HOURS=12      # projector link lifetime
# SPEED_BONUS_ENABLED=0       # default for new sessions (host can toggle per session)
# SPEED_BONUS_MAX=50
# LOG_LEVEL=INFO
# TRUST_X_FORWARDED_FOR=1   # default: same as DJANGO_SECURE_SSL (behind Heroku router)

# --- Local development example ---------------------------------------------------
# DJANGO_DEBUG=1
# DJANGO_SECURE_SSL=0
# DATABASE_URL=sqlite:///db.sqlite3
